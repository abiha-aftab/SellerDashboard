# Copy to .env to override the defaults used by docker compose.

# Host ports
API_PORT=8080
WEB_PORT=5173

# Backend
# Turn on the H2 web console at /h2-console (local debugging only)
H2_CONSOLE_ENABLED=false
# Seed three demo sellers with 30 days of sales on startup
DEMO_DATA_ENABLED=true
# Origins allowed to call /api directly from a browser (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
